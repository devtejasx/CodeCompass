# Copy to `.env` and fill in. Never commit `.env`.

# ── Database ────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/codecompass?schema=public"

# Separate database used by the test suite. It is reset on every run, so it
# must NOT point at your development database.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/codecompass_test?schema=public"

# Throwaway database Prisma replays migrations into when generating one with
# `migrate diff --from-migrations`. Only needed to author new migrations.
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/codecompass_shadow?schema=public"

# ── Auth.js ─────────────────────────────────────────────────────────────
# Secret used to sign session JWTs. Generate one with:
#   npx auth secret
# or:
#   openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Canonical origin. Required in production so callbacks resolve correctly.
# AUTH_URL="https://codecompass.dev"

# ── Code execution (Phase 6) ────────────────────────────────────────────
# CodeCompass NEVER executes learner code in this process. Submissions are
# handed to a separate, isolated execution service. See docs/code-execution.md
# for exactly what that service has to guarantee before it is used in
# production.
#
#   none  (default) nothing runs. Run and Submit are disabled and the problem
#         page says so. This is the correct state for an unconfigured deploy.
#   mock  development only. Returns deterministic, clearly-labelled SIMULATED
#         verdicts without running anything. Refused when NODE_ENV=production.
#   sandbox  production. Posts to CODE_EXECUTION_URL, which is the isolated
#            execution service in services/execution - a separate deployment
#            that runs each submission in a throwaway container with no
#            network, no secrets and no writable filesystem. `http` is accepted
#            as the older name for the same provider.
CODE_EXECUTION_PROVIDER="mock"

# Required when CODE_EXECUTION_PROVIDER=sandbox. The URL is the *execute* route;
# the health route beside it is derived, so the two can never point at
# different services.
#
# The token authenticates this application to the execution service. The
# service refuses every request when its own EXECUTION_TOKEN is unset, so this
# is required rather than recommended - and it is never present inside a
# sandbox, which has no network to use it on.
# CODE_EXECUTION_URL="https://exec.internal.codecompass.dev/v1/execute"
# CODE_EXECUTION_TOKEN="shared-secret-for-the-execution-service"

# Optional: restrict which languages are offered to those the service actually
# runs. Omit to offer all five. Unknown names are ignored, never added.
# CODE_EXECUTION_LANGUAGES="JAVASCRIPT,TYPESCRIPT,PYTHON,JAVA,CPP"

# ── GitHub integration (Phase 8) ────────────────────────────────────────
# Entirely optional. With none of this set, the Git & GitHub Academy works in
# full — curriculum, simulator, exercises, reference — and the connection UI
# says GitHub integration is not configured on this deployment. It fails
# closed; it never half-works.
#
# To enable it, register an OAuth app at
#   https://github.com/settings/developers → New OAuth App
# with the callback URL:
#   http://localhost:3000/api/github/callback     (development)
#   https://your-domain/api/github/callback       (production)
#
# GITHUB_CLIENT_ID="Iv1.xxxxxxxxxxxxxxxx"
# GITHUB_CLIENT_SECRET="your-oauth-app-client-secret"

# Encrypts GitHub access tokens at rest with AES-256-GCM. Must decode to
# exactly 32 bytes, as base64 or hex. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Losing or changing this key does not lose data — it invalidates stored tokens,
# and affected learners are asked to reconnect. Never commit a real value.
GITHUB_TOKEN_ENCRYPTION_KEY="replace-me-with-32-random-bytes-base64"

# Canonical origin used to build the OAuth callback URL. Falls back to
# AUTH_URL, then to http://localhost:3000 in development.
# APP_URL="https://codecompass.dev"

# ── AI guidance (Phase 10) ──────────────────────────────────────────────
# Entirely optional. With none of this set, CodeCompass works in full: your
# roadmap, your next step, every recommendation, the study plan and the weekly
# summary are all computed by a deterministic engine from your own progress.
# Only the conversational mentor needs a provider, and the page says so.
#
# AI is an enhancement here, never a dependency. It explains recommendations;
# it never produces them.
#
#   none       (default) no mentor. The rest of the product is unaffected.
#   mock       development only. Returns a clearly-labelled SIMULATED reply
#              without calling anything. Refused when NODE_ENV=production,
#              because simulated guidance a learner could mistake for real
#              advice is worse than no mentor.
#   anthropic  production. Requires ANTHROPIC_API_KEY below.
AI_PROVIDER="none"

# Required when AI_PROVIDER=anthropic. Server-side only: it is read in exactly
# one file (src/lib/ai/provider.ts), held in a private field on the adapter,
# and never returned, logged, stored in the database or sent to the browser.
# ANTHROPIC_API_KEY="sk-ant-..."

# Optional: pin a model without a code change.
# ANTHROPIC_MODEL="claude-sonnet-5"
