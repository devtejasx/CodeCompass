# Copy to `.env` and fill in. Never commit `.env`.

# ── Database ────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/codecompass?schema=public"

# Separate database used by the test suite. It is reset on every run, so it
# must NOT point at your development database.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/codecompass_test?schema=public"

# ── Auth.js ─────────────────────────────────────────────────────────────
# Secret used to sign session JWTs. Generate one with:
#   npx auth secret
# or:
#   openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Canonical origin. Required in production so callbacks resolve correctly.
# AUTH_URL="https://codecompass.dev"
