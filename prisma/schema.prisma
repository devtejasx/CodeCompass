// CodeCompass schema.
//
// Grown one phase at a time: auth + onboarding (2), career explorer (3),
// roadmap engine (4), learning system (5), coding practice (6), projects (7),
// Git & GitHub (8), the AI Tools Academy (9) and personalization (10).
//
// Sessions are JWTs, which is what Auth.js requires for the Credentials
// provider, so there is no Session table to store. Adding an OAuth provider in
// a later phase means adding the Auth.js Account/Session models and the Prisma
// adapter at that point.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Prisma 7 moved the connection URL out of the schema: Migrate reads it from
// prisma.config.ts, and the client gets it through a driver adapter.
datasource db {
  provider = "postgresql"
}

/// Where someone is starting from. Drives nothing yet — collected in onboarding.
enum ExperienceLevel {
  NEW_TO_TECH
  STARTED_LEARNING
  KNOWS_FUNDAMENTALS
  BUILDING_PROJECTS
}

/// A stated interest, not a commitment. NOT_SURE is a first-class answer:
/// a beginner must never be forced to pretend they already know.
enum CareerInterest {
  FRONTEND
  BACKEND
  FULL_STACK
  AI_ENGINEERING
  MACHINE_LEARNING
  DATA_SCIENCE
  DATA_ANALYTICS
  CYBERSECURITY
  DEVOPS
  CLOUD
  MOBILE
  GAME_DEV
  OTHER
  NOT_SURE
}

/// Realistic daily capacity. Used to understand the learner, not to promise dates.
enum DailyLearningTime {
  MINUTES_15_30
  MINUTES_30_60
  HOURS_1_2
  HOURS_2_4
  HOURS_4_PLUS
}

/// Language preference only. No recommendation logic exists in Phase 2.
enum ProgrammingLanguage {
  JAVASCRIPT_TYPESCRIPT
  PYTHON
  JAVA
  CSHARP
  GO
  RUST
  SWIFT
  KOTLIN
  CPP
  SOLIDITY
  OTHER
  NOT_SURE
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// bcrypt hash. Never a plaintext password, never returned to the client.
  passwordHash  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile Profile?

  /// Learning progress (Phase 5).
  topicProgress   UserTopicProgress[]
  sectionProgress UserSectionProgress[]

  /// Coding practice (Phase 6).
  problemProgress UserProblemProgress[]
  submissions     Submission[]

  /// Projects (Phase 7).
  projects UserProject[]

  /// Git & GitHub (Phase 8).
  githubConnection GitHubConnection?
  gitExercises     UserGitExercise[]

  /// AI Tools Academy (Phase 9).
  aiToolProgress     UserAIToolProgress[]
  aiWorkflowProgress UserAIWorkflowProgress[]

  /// Personalization & AI guidance (Phase 10).
  activities    UserActivity[]
  conversations MentorConversation[]
  aiUsage       AIUsage[]

  @@map("users")
}

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  experienceLevel ExperienceLevel?

  /// The *interest* stated during onboarding — a first instinct, not a
  /// commitment. Kept separate from selectedCareerId on purpose: comparing the
  /// two is what lets the explorer say "based on what you told us…" while
  /// still letting the user pick something else.
  selectedCareer CareerInterest?

  dailyLearningTime DailyLearningTime?
  selectedLanguage  ProgrammingLanguage?

  /// The career the user has actually committed to, chosen in the explorer.
  /// A relation rather than copied fields, so career content stays in one
  /// place. Nullable because "I'm not sure yet" is a valid, persistent state.
  selectedCareerId String?
  chosenCareer     Career? @relation(fields: [selectedCareerId], references: [id], onDelete: SetNull)

  /// Reserved: the Phase 2 flow deliberately asks only four questions, so
  /// nothing writes this yet. Kept nullable so a later step can fill it in
  /// without a destructive migration.
  primaryGoal String?

  /// How much help the AI mentor gives on a problem the learner is actively
  /// solving (Phase 10). Defaults to the conservative setting.
  mentorSolutionPolicy MentorSolutionPolicy @default(HINTS_ONLY)

  // ── Public profile (Phase 11) ─────────────────────────────────────────
  //
  // Six settings and a username, on Profile rather than in a table of their
  // own: every profile has all of them, so a 1:1 table would be a join with
  // no upside.
  //
  // Everything here defaults to private. A learner opts in to being visible,
  // and then opts in again to each section — the public page renders only
  // what is explicitly switched on.

  /// The public identifier, chosen by the learner. Null until they pick one.
  /// Unique, lowercase, and validated against a reserved list — see
  /// lib/profile/username. Never a database id: /u/<cuid> would leak the key
  /// used everywhere else in the schema.
  username String? @unique

  /// The master switch. With this off, /u/<username> is a 404 even for a
  /// username that exists.
  isPublic Boolean @default(false)

  publicShowProjects Boolean @default(true)
  publicShowSkills   Boolean @default(true)
  publicShowProgress Boolean @default(true)
  /// Off by default even though the others are on: a GitHub handle is an
  /// identity elsewhere, and linking it should be a deliberate act.
  publicShowGitHub   Boolean @default(false)

  onboardingCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([selectedCareerId])
  @@map("profiles")
}

// ─────────────────────────────────────────────────────────────────────────────
// Career Explorer (Phase 3)
//
// Careers are database-backed rather than hardcoded so the catalog can grow
// without a frontend change, and so Phase 4 can hang a Roadmap off a Career
// via a foreign key. Roadmap/RoadmapPhase/Topic/Lesson are NOT modelled here.
// ─────────────────────────────────────────────────────────────────────────────

enum CareerCategory {
  SOFTWARE_DEVELOPMENT
  DATA_AND_AI
  INFRASTRUCTURE_AND_CLOUD
  SECURITY
  DESIGN_AND_PRODUCT
  OTHER_TECHNOLOGY
}

enum CareerDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum DemandLevel {
  MODERATE
  HIGH
  VERY_HIGH
}

model Career {
  id   String @id @default(cuid())
  slug String @unique
  name String

  /// One line for the card.
  shortDescription String
  /// Beginner-facing explanation of what the person actually does all day.
  description      String
  /// One short phrase used by the comparison table ("User interface", …).
  mainFocus        String

  /// Lucide icon name, resolved through a registry at render time. A database
  /// row cannot carry a React component, so the name is what is stored.
  icon String

  category              CareerCategory
  difficulty            CareerDifficulty
  /// Human-readable range, e.g. "6–9 months". Deliberately not a number:
  /// we are describing a journey, not promising a completion date.
  estimatedLearningTime String
  demandLevel           DemandLevel

  /// Narrative lists. Plain string arrays because nothing else references
  /// them — promoting these to tables would be structure without a payoff.
  builds        String[]
  learningAreas String[]
  suitedFor     String[]
  challenges    String[]

  technologies CareerTechnology[]
  /// Outgoing "related career" edges; see CareerRelation.
  relatedTo    CareerRelation[]   @relation("CareerRelationsFrom")
  relatedFrom  CareerRelation[]   @relation("CareerRelationsTo")

  /// Users who have chosen this path.
  profiles Profile[]

  /// Every roadmap version authored for this career. Not every career has one
  /// yet — the explorer ships 20 careers, Phase 4 ships 3 roadmaps.
  roadmaps Roadmap[]

  /// AI tools worth learning on this path (Phase 9). A relation rather than a
  /// hardcoded map in a component, so the recommendations can change with the
  /// tooling landscape without a frontend edit.
  aiTools CareerAITool[]

  /// Controls catalog ordering without relying on insertion order.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([difficulty])
  @@map("careers")
}

/// A technology is its own row so the same "React" is shared across careers
/// and can be filtered on later without string matching.
model Technology {
  id   String @id @default(cuid())
  slug String @unique
  name String

  careers CareerTechnology[]

  @@map("technologies")
}

model CareerTechnology {
  careerId     String
  technologyId String

  career     Career     @relation(fields: [careerId], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  sortOrder Int @default(0)

  @@id([careerId, technologyId])
  @@map("career_technologies")
}

/// Directed edge between careers. Stored one way per pair as authored by the
/// seed; the seed writes both directions where the relationship is mutual.
model CareerRelation {
  careerId        String
  relatedCareerId String

  career        Career @relation("CareerRelationsFrom", fields: [careerId], references: [id], onDelete: Cascade)
  relatedCareer Career @relation("CareerRelationsTo", fields: [relatedCareerId], references: [id], onDelete: Cascade)

  sortOrder Int @default(0)

  @@id([careerId, relatedCareerId])
  @@map("career_relations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Roadmap Engine (Phase 4)
//
//   Career → Roadmap → RoadmapPhase → Topic
//
// Lesson, Resource, Practice, Quiz and Project are NOT modelled here. Topic is
// the attachment point for all of them in Phase 5, which is why it carries its
// own id and slug rather than being a bare string on the phase.
// ─────────────────────────────────────────────────────────────────────────────

/// How a phase is presented. Phase 4 has no real learner progress, so state is
/// derived (first phase available, rest locked) rather than stored per user.
enum PhaseKind {
  /// Ordinary learning phase.
  LEARNING
  /// A build-something milestone. Projects themselves are a later phase.
  PROJECT_MILESTONE
}

/// What a roadmap *is*. CAREER roadmaps belong to a career and drive the
/// explorer; ACADEMY roadmaps are career-independent curricula every learner
/// needs whatever path they picked — Git being the first of them.
enum RoadmapKind {
  CAREER
  ACADEMY
}

model Roadmap {
  id String @id @default(cuid())

  /// Null for an ACADEMY roadmap. Git and GitHub are not one career's concern,
  /// so the Academy hangs off no career — which is also what lets it reuse
  /// Topic, Lesson and UserTopicProgress unchanged rather than growing a
  /// parallel content and progress system of its own.
  careerId String?
  career   Career? @relation(fields: [careerId], references: [id], onDelete: Cascade)

  kind RoadmapKind @default(CAREER)

  /// Stable identifier for a roadmap that has no career to look it up by.
  /// Null for career roadmaps, which are found through their career.
  slug String? @unique

  title       String
  description String

  /// Monotonically increasing per career. Versioning is supported by the data
  /// model on purpose — a v2 roadmap can be seeded alongside v1 and swapped by
  /// flipping isActive, without migrating or deleting anything.
  version Int @default(1)

  /// Exactly one active version per career is expected; the partial-unique
  /// constraint that would enforce it needs raw SQL, so the seed asserts it and
  /// queries always filter on it.
  isActive Boolean @default(true)

  /// Free text ("8–12 months"). Same reasoning as Career.estimatedLearningTime:
  /// this describes a journey, it is not a promise of a completion date.
  estimatedDuration String

  phases RoadmapPhase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Postgres treats NULLs as distinct, so this constrains career roadmaps
  /// only — exactly the ones that need it.
  @@unique([careerId, version])
  @@index([careerId, isActive])
  @@index([kind, isActive])
  @@map("roadmaps")
}

model RoadmapPhase {
  id        String  @id @default(cuid())
  roadmapId String
  roadmap   Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  title       String
  description String

  /// 1-based position. Unique per roadmap so two phases can never claim the
  /// same slot and silently render in arbitrary order.
  order Int

  estimatedDuration String
  kind              PhaseKind @default(LEARNING)

  /// The CodeCompass differentiator: why this phase comes where it does.
  /// Explaining the ordering is what separates this from a list of tech.
  whyThisComesNext String

  topics Topic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roadmapId, order])
  @@index([roadmapId])
  @@map("roadmap_phases")
}

model Topic {
  id      String       @id @default(cuid())
  phaseId String
  phase   RoadmapPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  /// Globally unique so /learn/[slug] can resolve a topic on its own. Roadmaps
  /// prefix where they would otherwise collide (fs-git vs git-fundamentals).
  slug        String @unique
  title       String
  description String

  order Int

  difficulty    CareerDifficulty
  /// Human-readable ("45 minutes"). Phase 5 can add a numeric field for
  /// scheduling; this one is for display.
  estimatedTime String

  /// Optional topics are enrichment — a learner can skip them and still be
  /// ready for the next phase.
  isRequired Boolean @default(true)

  /// Edges pointing at what must come first, and back-edges for "unlocks".
  prerequisites TopicPrerequisite[] @relation("TopicNeeds")
  requiredBy    TopicPrerequisite[] @relation("TopicUnlocks")

  /// The learning content for this topic. Optional: a topic without a lesson
  /// renders "content coming soon" rather than a broken page.
  lesson Lesson?

  /// Per-user learning progress.
  progress UserTopicProgress[]

  /// Coding problems that practise this topic (Phase 6). The join carries no
  /// data of its own yet, but exists as a table so it can later.
  problems ProblemTopic[]

  /// Projects that build on this topic (Phase 7).
  projects ProjectConcept[]

  /// Steps in an AI tool's learning path that teach this topic (Phase 9).
  /// The AI Academy authors its curriculum as ordinary Topics, so a tool's
  /// path is an ordering over existing content rather than a second library.
  aiToolLessons AIToolLesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([phaseId, order])
  @@index([phaseId])
  @@map("topics")
}

/// Explicit join table rather than a self-referencing many-to-many, so an edge
/// can later carry its own metadata (strength, "recommended" vs "required")
/// without a migration.
model TopicPrerequisite {
  topicId        String
  prerequisiteId String

  topic        Topic @relation("TopicNeeds", fields: [topicId], references: [id], onDelete: Cascade)
  prerequisite Topic @relation("TopicUnlocks", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([topicId, prerequisiteId])
  @@index([prerequisiteId])
  @@map("topic_prerequisites")
}

// ─────────────────────────────────────────────────────────────────────────────
// Learning System (Phase 5)
//
//   Topic → Lesson → LessonSection
//                  → KnowledgeCheck → KnowledgeCheckOption
//                  → Resource
//
// Plus per-user progress. Practice, coding problems and projects hang off
// Topic in Phase 6; nothing here forecloses that.
// ─────────────────────────────────────────────────────────────────────────────

/// How a lesson section is rendered. Content is data, not JSX, so new lessons
/// are a seed change rather than a frontend change.
enum SectionType {
  /// Explanatory prose.
  TEXT
  /// A sub-heading inside the lesson.
  HEADING
  /// Bullet points; uses `items`.
  LIST
  /// Something worth remembering.
  CALLOUT
  /// A common mistake to avoid.
  WARNING
  /// A code sample; uses `code` and `language`. Never executed in Phase 5.
  CODE
  /// A worked example combining prose and code.
  EXAMPLE
}

enum ResourceType {
  ARTICLE
  DOCUMENTATION
  VIDEO
  REFERENCE
}

enum TopicProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Lesson {
  id      String @id @default(cuid())
  /// One lesson per topic. A second lesson would be a new topic.
  topicId String @unique
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  title         String
  description   String
  /// Display string ("45 minutes"), mirroring Topic.estimatedTime.
  estimatedTime String

  /// Lets content be revised without losing the ability to describe which
  /// version a learner saw. Not surfaced in the UI yet.
  version Int @default(1)

  sections        LessonSection[]
  knowledgeChecks KnowledgeCheck[]
  resources       Resource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lessons")
}

model LessonSection {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  /// Optional: a CODE or CALLOUT block often needs no title of its own.
  title   String?
  type    SectionType @default(TEXT)
  /// Prose for TEXT/HEADING/CALLOUT/WARNING/EXAMPLE; the lead-in for CODE.
  content String

  /// LIST items. Empty for every other type.
  items String[]

  /// CODE only.
  code     String?
  language String?

  order Int

  progress UserSectionProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, order])
  @@index([lessonId])
  @@map("lesson_sections")
}

model KnowledgeCheck {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  question    String
  /// Shown after answering — the feedback is meant to teach, not just score.
  explanation String
  order       Int

  options KnowledgeCheckOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, order])
  @@index([lessonId])
  @@map("knowledge_checks")
}

model KnowledgeCheckOption {
  id               String         @id @default(cuid())
  knowledgeCheckId String
  knowledgeCheck   KnowledgeCheck @relation(fields: [knowledgeCheckId], references: [id], onDelete: Cascade)

  text      String
  /// Never selected when sending options to the browser — grading is server-side.
  isCorrect Boolean @default(false)
  order     Int

  @@unique([knowledgeCheckId, order])
  @@index([knowledgeCheckId])
  @@map("knowledge_check_options")
}

/// Curated external links. Never scraped, never embedded — displayed with their
/// source and opened in a new tab.
model Resource {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  title       String
  url         String
  type        ResourceType @default(ARTICLE)
  description String?
  /// Shown to the reader so they know where a link goes before clicking.
  source      String
  order       Int

  @@unique([lessonId, order])
  @@index([lessonId])
  @@map("resources")
}

model UserTopicProgress {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  status          TopicProgressStatus @default(NOT_STARTED)
  /// 0–100, derived from completed sections plus the knowledge check.
  percentComplete Int                 @default(0)

  /// Best knowledge-check result so far, as a percentage. Null until attempted.
  bestScore Int?
  attempts  Int  @default(0)

  startedAt      DateTime?
  completedAt    DateTime?
  lastAccessedAt DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, topicId])
  @@index([userId])
  @@index([topicId])
  @@map("user_topic_progress")
}

/// Which sections a learner has ticked off, so leaving mid-lesson and coming
/// back lands them in the right place.
model UserSectionProgress {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sectionId String
  section   LessonSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  completedAt DateTime @default(now())

  @@unique([userId, sectionId])
  @@index([userId])
  @@map("user_section_progress")
}

// ─────────────────────────────────────────────────────────────────────────────
// Coding Practice Engine (Phase 6)
//
//   Topic → ProblemTopic → PracticeProblem → PracticeExample
//                                          → PracticeTestCase
//                                          → PracticeLanguage
//
// Plus per-user progress and a submission log. Problem content is
// application-owned: nothing in the app writes to a problem, only reads.
//
// User code is NEVER executed by this application. Submissions are handed to an
// external, isolated execution service — see src/lib/practice/execution.
// ─────────────────────────────────────────────────────────────────────────────

/// Separate from CareerDifficulty on purpose: a problem's difficulty and a
/// career's difficulty are different scales that happen to share three words.
enum ProblemDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ProblemStatus {
  NOT_STARTED
  ATTEMPTED
  SOLVED
}

/// Languages the practice engine can offer. A language is only shown when the
/// configured execution service reports that it supports it AND the problem has
/// starter code for it, so this enum growing does not by itself expose a
/// language that cannot run.
enum CodeLanguage {
  JAVASCRIPT
  TYPESCRIPT
  PYTHON
  JAVA
  CPP
}

/// "Run" checks the visible sample tests only; "Submit" runs everything,
/// including hidden tests, and is what can mark a problem solved.
enum SubmissionKind {
  RUN
  SUBMIT
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT
  MEMORY_LIMIT
  COMPILE_ERROR
  RUNTIME_ERROR
  SYSTEM_ERROR
}

model PracticeProblem {
  id   String @id @default(cuid())
  slug String @unique

  title       String
  /// The problem statement, in plain prose. Original content — never copied
  /// from LeetCode, CodeChef or any other platform.
  description String
  difficulty  ProblemDifficulty

  /// Taught after an attempt: why the intended approach works. Stored rather
  /// than generated, because Phase 6 has no AI.
  explanation String

  constraints String[]
  /// Progressive nudges. Revealed one at a time, never all at once.
  hints       String[]

  /// The function the learner implements. The execution harness calls it by
  /// this name, so it belongs to the problem definition, not to the UI.
  functionName String

  /// Per-problem limits, enforced by the sandbox. Stored per problem so a
  /// heavier problem can be given more room without a global change.
  timeLimitMs   Int @default(2000)
  memoryLimitMb Int @default(128)

  /// Display only ("~10 min"), mirroring Topic.estimatedTime.
  estimatedTime String @default("10 min")

  /// Stable catalog ordering, independent of insertion order.
  sortOrder Int @default(0)

  examples  PracticeExample[]
  testCases PracticeTestCase[]
  languages PracticeLanguage[]
  topics    ProblemTopic[]

  progress    UserProblemProgress[]
  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([difficulty])
  @@map("practice_problems")
}

/// A worked example shown in the problem statement. Distinct from a test case:
/// examples teach, test cases grade. They are authored to agree, but editing an
/// example must never silently change what is graded.
model PracticeExample {
  id        String          @id @default(cuid())
  problemId String
  problem   PracticeProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  input       String
  output      String
  explanation String?
  order       Int

  @@unique([problemId, order])
  @@index([problemId])
  @@map("practice_examples")
}

/// One graded case.
///
/// `input` is a JSON array of arguments and `expectedOutput` a JSON value, so
/// the same case runs under any language harness without being re-authored.
/// Hidden cases are never selected by any query that feeds the browser.
model PracticeTestCase {
  id        String          @id @default(cuid())
  problemId String
  problem   PracticeProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  input          String
  expectedOutput String
  isHidden       Boolean @default(false)
  order          Int

  @@unique([problemId, order])
  @@index([problemId, isHidden])
  @@map("practice_test_cases")
}

/// Per-language configuration for a problem. A language a problem has no row
/// for is simply not offered for it.
model PracticeLanguage {
  id        String          @id @default(cuid())
  problemId String
  problem   PracticeProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  language         CodeLanguage
  /// What the editor opens with. Generated from the problem's signature at seed
  /// time — never hardcoded in a React component.
  starterCode      String
  /// Reference solution. Server-side only: it is an answer key, and no query
  /// that feeds the browser selects it.
  solutionTemplate String?

  @@unique([problemId, language])
  @@index([problemId])
  @@map("practice_languages")
}

/// Connects practice to learning. This edge is what lets CodeCompass say "you
/// just studied X, now practise it" instead of showing a random problem library.
model ProblemTopic {
  problemId String
  topicId   String

  problem PracticeProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  topic   Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([problemId, topicId])
  @@index([topicId])
  @@map("problem_topics")
}

model UserProblemProgress {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  problemId String
  problem   PracticeProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  status   ProblemStatus @default(NOT_STARTED)
  /// Counts graded submissions, not editor keystrokes.
  attempts Int           @default(0)

  /// Set once, by the first accepted submission. A later failed attempt never
  /// clears it — solved stays solved.
  solvedAt DateTime?

  /// Which language the accepted solution used, for "solved in Python".
  solvedLanguage CodeLanguage?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, problemId])
  @@index([userId, status])
  @@index([problemId])
  @@map("user_problem_progress")
}

/// One graded execution. Owned by the user who created it: every read is scoped
/// by userId, and nothing joins across users.
model Submission {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  problemId String
  problem   PracticeProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  language CodeLanguage
  /// The learner's own source. Never shown to anybody else.
  code     String

  kind   SubmissionKind   @default(SUBMIT)
  status SubmissionStatus @default(QUEUED)

  passedTests Int @default(0)
  totalTests  Int @default(0)

  /// Milliseconds and kilobytes as reported by the sandbox. Null when the
  /// provider cannot measure them.
  executionTime Int?
  memoryUsed    Int?

  /// Sanitised compiler or runtime message. The execution layer strips paths,
  /// hostnames and stack frames before anything is stored here.
  message  String?
  /// Deterministic teaching note about the first failure. Rule-based, not AI.
  feedback String?

  /// Failure detail. Only ever written when the failing case is a *visible*
  /// one — a hidden case reports its number and nothing else, so the answer key
  /// cannot be reconstructed by submitting repeatedly.
  failedTestOrder Int?
  failedInput     String?
  expectedOutput  String?
  actualOutput    String?

  /// True when the verdict came from the development provider rather than a
  /// real sandbox, so a simulated result is never mistaken for a real one.
  simulated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, problemId, createdAt])
  @@index([userId, status])
  @@map("submissions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Project-Based Learning (Phase 7)
//
//   Topic → ProjectConcept → Project → ProjectRequirement
//                                    → ProjectMilestone
//                                    → ProjectTechnology
//                                    → ProjectHint
//                                    → ProjectResource
//
// Plus per-user progress: UserProject, its milestone ticks and its
// self-evaluation ticks.
//
// The split that matters: project *definitions* are application-owned and are
// only ever read by the app, while UserProject and everything hanging off it is
// user-owned and only ever written through the session user. Nothing in the
// app writes a Project row outside the seed.
//
// CodeCompass does not build the project for the learner. There is deliberately
// no model here for source code, no generated scaffold and no solution — hints
// guide thinking, requirements define done, and the learner writes the code.
// ─────────────────────────────────────────────────────────────────────────────

/// Reflects actual complexity, not encouragement. A project is BEGINNER because
/// it needs few concepts and little architecture, not because it sounds easy.
enum ProjectDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

/// Only the three types with seeded careers are used today. The rest exist so
/// adding a data or mobile roadmap later is a seed change, not a migration.
enum ProjectType {
  FRONTEND
  BACKEND
  FULL_STACK
  DATA
  AI
  MOBILE
  OTHER
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

/// LOCKED means "this project hasn't been started", not "you may not do this
/// step yet". Real building is not linear: once a project is started every
/// milestone is AVAILABLE, and the learner ticks them off in whatever order
/// they actually worked.
enum MilestoneStatus {
  LOCKED
  AVAILABLE
  COMPLETED
}

/// Splits the self-evaluation checklist into "does it work?" and "is it built
/// well?", which are different questions and worth asking separately.
enum RequirementCategory {
  FUNCTIONAL
  TECHNICAL
}

enum TechnologyCategory {
  LANGUAGE
  FRAMEWORK
  LIBRARY
  STYLING
  DATABASE
  TOOL
  PLATFORM
}

model Project {
  id   String @id @default(cuid())
  slug String @unique

  title            String
  /// One line for the card.
  shortDescription String
  /// What the project is, in prose.
  description      String

  difficulty ProjectDifficulty
  type       ProjectType

  /// Human-readable ("4–6 hours"). Same reasoning as everywhere else in this
  /// schema: we are describing effort, not promising a completion time.
  estimatedDuration String

  /// Section 1 of the detail page — what the learner gains, and why this
  /// project is worth their evening.
  whyBuildThis String
  /// Section 2 — the outcome, described so they can picture the finished thing.
  whatYouBuild String

  sortOrder Int @default(0)

  requirements ProjectRequirement[]
  milestones   ProjectMilestone[]
  technologies ProjectTechnology[]
  concepts     ProjectConcept[]
  hints        ProjectHint[]
  resources    ProjectResource[]

  userProjects UserProject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([difficulty])
  @@index([type])
  @@map("projects")
}

/// One acceptance criterion. Doubles as the self-evaluation checklist: the
/// question "is it finished?" should be answered against the same list that
/// defined "what should it do?", not a second list invented at the end.
model ProjectRequirement {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  description String
  category    RequirementCategory @default(FUNCTIONAL)
  /// Optional requirements are stretch goals; they never block completion.
  isRequired  Boolean             @default(true)
  order       Int

  confirmations UserProjectRequirement[]

  @@unique([projectId, order])
  @@index([projectId])
  @@map("project_requirements")
}

model ProjectMilestone {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title         String
  description   String
  order         Int
  /// Display string ("45 minutes").
  estimatedTime String
  /// Concepts this step exercises. A plain array: nothing joins on these, and
  /// promoting them to rows would be structure without a payoff.
  concepts      String[]

  progress UserProjectMilestone[]

  @@unique([projectId, order])
  @@index([projectId])
  @@map("project_milestones")
}

model ProjectTechnology {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name     String
  category TechnologyCategory @default(TOOL)
  order    Int

  @@unique([projectId, order])
  @@index([projectId])
  @@map("project_technologies")
}

/// Connects a project to the learning it reinforces. This edge is what lets the
/// system answer "why is this recommended to me?" with something true, and what
/// stops a project being suggested to someone who hasn't learned its parts yet.
model ProjectConcept {
  projectId String
  topicId   String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  /// True when the topic must be completed before the project is recommended.
  /// False for a concept the project touches but does not depend on, so a
  /// project can advertise what it practises without gating on all of it.
  isPrerequisite Boolean @default(true)

  createdAt DateTime @default(now())

  @@id([projectId, topicId])
  @@index([topicId])
  @@map("project_concepts")
}

/// Progressive nudges, revealed one at a time. A hint points at the next
/// question to ask; it never contains the implementation.
model ProjectHint {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title   String
  content String
  order   Int

  @@unique([projectId, order])
  @@index([projectId])
  @@map("project_hints")
}

/// Curated external documentation. Never scraped, never embedded — shown with
/// its source and opened in a new tab, same as lesson resources.
model ProjectResource {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title  String
  url    String
  source String
  type   ResourceType @default(DOCUMENTATION)
  order  Int

  @@unique([projectId, order])
  @@index([projectId])
  @@map("project_resources")
}

/// One learner's run at one project. User-owned: every read and write is scoped
/// by the session user id.
model UserProject {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status ProjectStatus @default(NOT_STARTED)

  startedAt   DateTime?
  completedAt DateTime?

  /// Typed in by the learner. Stored, never fetched — CodeCompass does not
  /// visit these and does not claim they work. Kept alongside the GitHub link
  /// below rather than replaced by it: not everybody uses GitHub, and Phase 7
  /// worked without it.
  repositoryUrl String?
  deployedUrl   String?

  /// A repository the learner picked or created through the GitHub connection
  /// (Phase 8). Denormalised on purpose — these are a snapshot for display, so
  /// the project page can render without an API call on every load. GitHub
  /// remains the source of truth and a refresh re-reads it.
  githubRepoId        BigInt?
  githubRepoFullName  String?
  githubRepoUrl       String?
  githubDefaultBranch String?
  githubRepoPrivate   Boolean?
  githubLinkedAt      DateTime?

  /// The learner's own notes on what they built and what they'd change.
  notes String?

  milestones    UserProjectMilestone[]
  confirmations UserProjectRequirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, projectId])
  @@index([userId, status])
  @@index([projectId])
  @@map("user_projects")
}

model UserProjectMilestone {
  id            String      @id @default(cuid())
  userProjectId String
  userProject   UserProject @relation(fields: [userProjectId], references: [id], onDelete: Cascade)

  milestoneId String
  milestone   ProjectMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  status      MilestoneStatus @default(AVAILABLE)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userProjectId, milestoneId])
  @@index([userProjectId])
  @@map("user_project_milestones")
}

/// A self-evaluation tick. The learner asserting a requirement is met — not the
/// application verifying it, and the UI never claims otherwise.
model UserProjectRequirement {
  userProjectId String
  userProject   UserProject @relation(fields: [userProjectId], references: [id], onDelete: Cascade)

  requirementId String
  requirement   ProjectRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  confirmedAt DateTime @default(now())

  @@id([userProjectId, requirementId])
  @@index([requirementId])
  @@map("user_project_requirements")
}

// ─────────────────────────────────────────────────────────────────────────────
// Git & GitHub (Phase 8)
//
// Two halves that stay separate on purpose.
//
// The *curriculum* is not modelled here at all. Git lessons are Topics in an
// ACADEMY Roadmap, so they reuse Lesson, LessonSection, KnowledgeCheck,
// UserTopicProgress and UserSectionProgress exactly as the career roadmaps do —
// a second progress system for the same kind of content would be a liability,
// not a feature. Only the interactive exercises, which are not lessons, get a
// table of their own.
//
// The *integration* is GitHubConnection: one row per learner, holding an
// encrypted OAuth token that is never selected by any query feeding a page.
// ─────────────────────────────────────────────────────────────────────────────

/// Only states that can actually persist. NOT_CONNECTED is the absence of a
/// row and DISCONNECTED is its deletion, so neither is storable — the TypeScript
/// view type in lib/github/connection.ts adds them for the UI.
enum GitHubConnectionStatus {
  CONNECTED
  /// GitHub rejected the token: revoked in the user's settings, or expired.
  /// The row is kept so the UI can say "reconnect" rather than "connect", and
  /// so the linked repositories on projects survive a re-authorisation.
  AUTHORIZATION_EXPIRED
}

/// One learner's GitHub authorisation.
///
/// The access token is stored encrypted with AES-256-GCM under a key that lives
/// only in the environment (see lib/github/crypto.ts). It is decrypted in the
/// server-side GitHub service and nowhere else: no query that feeds a page
/// selects the ciphertext, no action returns it, and nothing logs it.
model GitHubConnection {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// GitHub's numeric account id. The stable identity — a username can change.
  ///
  /// Deliberately NOT unique. GitHub is a linked integration here, not the
  /// login mechanism: CodeCompass has its own authentication, and the natural
  /// key is userId, which is unique above. Making GitHub identity a global key
  /// would mean the second learner to link a shared account hits an opaque
  /// constraint violation, enforcing a restriction the product never needed.
  githubUserId BigInt
  username     String
  avatarUrl    String?
  profileUrl   String
  name         String?
  publicRepos  Int     @default(0)

  /// AES-256-GCM. Split across three columns rather than one blob so the shape
  /// is obvious and a mistake is loud rather than silently unauthenticated.
  accessTokenCipher String
  accessTokenIv     String
  accessTokenTag    String
  /// Which key version encrypted this, so a key rotation can re-encrypt rather
  /// than force every learner to reconnect.
  keyVersion        Int    @default(1)

  /// Exactly what the learner granted. Stored so the UI can explain what
  /// CodeCompass can and cannot do, and so a missing scope is a clear message
  /// rather than a confusing API failure.
  scope String

  status GitHubConnectionStatus @default(CONNECTED)

  connectedAt    DateTime  @default(now())
  lastVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("github_connections")
}

enum GitExerciseStatus {
  ATTEMPTED
  COMPLETED
}

/// Progress on the interactive Git exercises.
///
/// The exercises themselves live in code, not in the database: each one is a
/// starting repository state plus a predicate over the simulator's end state,
/// which is logic rather than content. Progress is keyed by slug, and the seed
/// validator asserts every slug still exists so a renamed exercise is loud.
model UserGitExercise {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  exerciseSlug String
  status       GitExerciseStatus @default(ATTEMPTED)
  attempts     Int               @default(0)
  /// How many hints they revealed. Recorded to inform the content, not to judge.
  hintsUsed    Int               @default(0)
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, exerciseSlug])
  @@index([userId, status])
  @@map("user_git_exercises")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI Tools Academy (Phase 9)
//
//   AIToolCategory → AITool → AIToolCapability
//                           → AIToolUseCase
//                           → AIToolResource
//                           → AIToolLearningPath → AIToolLesson → Topic
//                           → CareerAITool → Career
//
//   AIWorkflow → AIWorkflowStep
//              → AIWorkflowPrompt
//              → AIWorkflowTool → AITool
//
// Two decisions run through this whole block.
//
// First: AI tools change faster than anything else CodeCompass teaches. Every
// name, URL, capability and limitation is a database row, so a tool being
// renamed, deprecated or gaining a feature is a seed change — never a React
// change. `status` and `lastVerifiedAt` exist so an out-of-date record can say
// so rather than quietly lie.
//
// Second: the *teaching* is not modelled here. AI lessons are Topics in an
// ACADEMY Roadmap, exactly like the Git Academy, so they reuse Lesson,
// LessonSection, KnowledgeCheck, Resource and UserTopicProgress unchanged.
// AIToolLesson is therefore a pointer at a Topic with a per-tool ordering, not
// a second copy of the lesson system. UserAIToolProgress records tool-level
// intent and a percentage derived from those topics.
//
// Nothing in this phase calls a model API. No key is read, no request is made:
// the Academy teaches about these tools, it does not embed them.
// ─────────────────────────────────────────────────────────────────────────────

/// A tool's lifecycle, so a record that is no longer current can be kept and
/// labelled rather than deleted. DEPRECATED covers renamed and discontinued
/// products alike — see AITool.supersededBySlug for where a learner should go.
enum AIToolStatus {
  ACTIVE
  BETA
  DEPRECATED
}

/// What someone is actually trying to do. This is the vocabulary shared by the
/// use-case filter, the decision helper and the career recommendations, which
/// is why it is an enum rather than free text: three features agreeing on the
/// same words is the whole point.
enum AIUseCase {
  WRITE_CODE
  UNDERSTAND_CODE
  DEBUG
  TEST
  DOCUMENT
  REFACTOR
  RESEARCH
  LEARN
  DESIGN_UI
  BUILD_APP
  AUTOMATE
  BUILD_WITH_AI
  ANALYSE_DATA
  ARCHITECTURE
}

/// Where the tool is used. The decision helper's second question ("which
/// environment?") is answered against exactly this list.
enum AIToolEnvironment {
  /// Runs inside a code editor.
  IDE
  /// Used in a browser tab.
  BROWSER
  /// A command-line program.
  TERMINAL
  /// Called from your own code.
  API
  /// A hosted platform you build inside.
  PLATFORM
}

enum AIWorkflowCategory {
  DEBUGGING
  LEARNING
  UNDERSTANDING
  TESTING
  DOCUMENTATION
  REFACTORING
  RESEARCH
  ARCHITECTURE
  PLANNING
  REVIEW
}

enum AIToolProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

/// Deliberately few. A taxonomy a learner cannot hold in their head is not a
/// taxonomy, it is a tag cloud.
model AIToolCategory {
  id   String @id @default(cuid())
  slug String @unique
  name String

  description String
  /// Lucide icon name, resolved through a registry at render time.
  icon        String @default("Sparkles")

  order Int @default(0)

  tools AITool[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_tool_categories")
}

model AITool {
  id   String @id @default(cuid())
  slug String @unique
  name String

  /// One line for the card.
  description     String
  /// A paragraph for the detail hero.
  longDescription String

  /// Section 1 of the detail page: what the tool actually does, in plain
  /// language. Kept separate from longDescription because "what is it" and
  /// "how would you describe it in a sentence" are different jobs.
  whatItIs String

  /// Sections 2, 3 and 5. Plain string arrays for the same reason Career's
  /// narrative lists are: nothing joins on them, so promoting them to tables
  /// would be structure without a payoff.
  whenToUse    String[]
  whenNotToUse String[]
  limitations  String[]

  /// Section 6 — how developers actually use it, in prose.
  howDevelopersUseIt String

  /// Never invented. Both are checked by the seed validator, which rejects
  /// anything that is not an https URL.
  officialUrl String
  docsUrl     String?

  categoryId String
  category   AIToolCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  status     AIToolStatus     @default(ACTIVE)
  difficulty CareerDifficulty @default(BEGINNER)

  /// The one thing to say if you only get one line: "AI-assisted development".
  primaryUse String

  environments AIToolEnvironment[]

  /// Lucide icon name. Tool logos are deliberately NOT downloaded: brand assets
  /// have licences, and a wrong or invented logo is worse than a clean glyph.
  iconIdentifier String @default("Sparkles")

  /// When a human last checked this record against the official source, and
  /// what they checked it against. Null means "never verified" — which is
  /// exactly what should be shown, rather than a comforting fake date.
  lastVerifiedAt     DateTime?
  verificationSource String?

  /// Where a learner should go instead, for a tool that was renamed or
  /// discontinued. A slug rather than a relation: the successor may not be in
  /// the catalog, and a dangling foreign key would be worse than a dead link
  /// the UI can simply not render.
  supersededBySlug String?
  /// One sentence explaining the DEPRECATED status, shown wherever the badge is.
  statusNote       String?

  sortOrder Int @default(0)

  capabilities  AIToolCapability[]
  useCases      AIToolUseCase[]
  resources     AIToolResource[]
  learningPaths AIToolLearningPath[]
  careers       CareerAITool[]
  workflows     AIWorkflowTool[]

  progress UserAIToolProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([difficulty])
  @@map("ai_tools")
}

/// One verified capability. A row exists only when the capability was confirmed
/// against the tool's own documentation — the comparison table reads these
/// directly, so an unchecked claim here becomes a claim CodeCompass makes.
model AIToolCapability {
  id     String @id @default(cuid())
  toolId String
  tool   AITool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  capability String
  /// What it means for someone who has not used the tool.
  detail     String?
  order      Int

  @@unique([toolId, order])
  @@index([toolId])
  @@map("ai_tool_capabilities")
}

/// Connects a tool to a thing a person is trying to do. Powers the use-case
/// filter and the decision helper, and carries the sentence that explains the
/// match so a recommendation is never an unexplained list.
model AIToolUseCase {
  id     String @id @default(cuid())
  toolId String
  tool   AITool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  useCase AIUseCase
  /// Why this tool suits this job.
  note    String
  order   Int

  @@unique([toolId, useCase])
  @@index([useCase])
  @@map("ai_tool_use_cases")
}

/// Curated official links. Never scraped, never embedded — shown with their
/// source and opened in a new tab, exactly like lesson and project resources.
model AIToolResource {
  id     String @id @default(cuid())
  toolId String
  tool   AITool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  title       String
  url         String
  type        ResourceType @default(DOCUMENTATION)
  description String?
  /// Shown to the reader so they know where a link goes before clicking.
  source      String
  order       Int

  @@unique([toolId, order])
  @@index([toolId])
  @@map("ai_tool_resources")
}

/// The ordered curriculum for one tool.
///
/// Every tool gets its own path rather than a shared template: what a learner
/// needs from an AI coding assistant is not what they need from an automation
/// platform, and pretending otherwise would be filler.
model AIToolLearningPath {
  id     String @id @default(cuid())
  toolId String
  tool   AITool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  slug        String @unique
  title       String
  description String

  difficulty    CareerDifficulty @default(BEGINNER)
  /// Display string ("2–3 hours"), mirroring every other estimate in this schema.
  estimatedTime String

  order Int @default(0)

  lessons AIToolLesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([toolId])
  @@map("ai_tool_learning_paths")
}

/// One level in a tool's path.
///
/// `topicId` is what makes this a pointer rather than a parallel content
/// system: the teaching lives in a Topic and its Lesson, so completion is
/// ordinary UserTopicProgress and a learner who studies "Debugging with AI"
/// once has studied it for every tool whose path includes it. Nullable so a
/// level can be authored before its lesson exists, in which case the UI says
/// "coming soon" rather than linking nowhere.
model AIToolLesson {
  id             String             @id @default(cuid())
  learningPathId String
  learningPath   AIToolLearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)

  title         String
  description   String
  order         Int
  /// Display string ("25 minutes").
  estimatedTime String

  topicId String?
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@unique([learningPathId, order])
  @@index([learningPathId])
  @@index([topicId])
  @@map("ai_tool_lessons")
}

/// Career → tool → use case.
///
/// The relationship the recommendations are built from. Storing *why* alongside
/// the edge is what lets the explorer say "recommended for Frontend Developer
/// because…" instead of showing an unexplained list of logos.
model CareerAITool {
  careerId String
  toolId   String

  career Career @relation(fields: [careerId], references: [id], onDelete: Cascade)
  tool   AITool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  /// The job this tool does on this path.
  useCase AIUseCase
  /// One sentence, shown on the recommendation card.
  reason  String

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@id([careerId, toolId])
  @@index([toolId])
  @@map("career_ai_tools")
}

/// A repeatable way of working with AI on a real development task.
///
/// The point of the library is that AI is a step *inside* a process the
/// developer owns — which is why every workflow has to declare what to verify
/// and what usually goes wrong, not just a list of steps.
model AIWorkflow {
  id   String @id @default(cuid())
  slug String @unique

  title   String
  /// What you are trying to achieve, in one sentence.
  goal    String
  /// A short paragraph of context.
  summary String

  category      AIWorkflowCategory
  difficulty    CareerDifficulty   @default(BEGINNER)
  /// Display string ("15 minutes").
  estimatedTime String

  /// How to check the AI did not lead you astray, and the mistakes this
  /// workflow exists to prevent. Both required by the seed validator: a
  /// workflow without them teaches copy-and-paste.
  whatToVerify   String[]
  commonMistakes String[]

  sortOrder Int @default(0)

  steps   AIWorkflowStep[]
  prompts AIWorkflowPrompt[]
  tools   AIWorkflowTool[]

  progress UserAIWorkflowProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("ai_workflows")
}

model AIWorkflowStep {
  id         String     @id @default(cuid())
  workflowId String
  workflow   AIWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  title  String
  detail String
  order  Int

  /// True for the steps the human does, false for the one where AI is asked.
  /// Rendered as a label so the division of labour is visible at a glance
  /// rather than implied by the prose.
  isHumanStep Boolean @default(true)

  @@unique([workflowId, order])
  @@index([workflowId])
  @@map("ai_workflow_steps")
}

/// A worked prompt, broken into its parts.
///
/// Split into goal/context/request rather than stored as one blob on purpose:
/// the teaching is the *structure*, and a learner who copies a magic string has
/// learned nothing they can reuse on their own problem.
model AIWorkflowPrompt {
  id         String     @id @default(cuid())
  workflowId String
  workflow   AIWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  label   String
  goal    String
  context String
  request String

  /// The part that matters: why this prompt works better than "fix my code".
  whyItWorks String

  order Int

  @@unique([workflowId, order])
  @@index([workflowId])
  @@map("ai_workflow_prompts")
}

/// Which tools this workflow is realistic with. Not an endorsement and not
/// exclusive — a workflow usually works with several.
model AIWorkflowTool {
  workflowId String
  toolId     String

  workflow AIWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  tool     AITool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  sortOrder Int @default(0)

  @@id([workflowId, toolId])
  @@index([toolId])
  @@map("ai_workflow_tools")
}

/// One learner's progress through one tool's curriculum.
///
/// `percentComplete` is derived from the UserTopicProgress rows behind the
/// path's lessons and is rewritten by lib/ai-tools/progress on every change, so
/// the two can never disagree: the topics are the source of truth and this row
/// is a maintained projection, kept so the dashboard can read one table.
///
/// User-owned. Every read and write is scoped by the session user id.
model UserAIToolProgress {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  toolId String
  tool   AITool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  status          AIToolProgressStatus @default(NOT_STARTED)
  percentComplete Int                  @default(0)

  startedAt      DateTime?
  completedAt    DateTime?
  lastAccessedAt DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, toolId])
  @@index([userId, status])
  @@index([toolId])
  @@map("user_ai_tool_progress")
}

/// A learner marking a workflow as one they have actually used.
///
/// Self-reported, exactly like a project's self-evaluation: CodeCompass cannot
/// watch someone debug, and the UI never claims it verified anything.
model UserAIWorkflowProgress {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workflowId String
  workflow   AIWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  completedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, workflowId])
  @@index([userId])
  @@map("user_ai_workflow_progress")
}

// ─────────────────────────────────────────────────────────────────────────────
// Personalization & AI Guidance (Phase 10)
//
//   UserActivity                    — what happened, for summaries and recency
//   MentorConversation → MentorMessage — the AI mentor's stored chats
//   AIUsage                         — one row per AI call, for rate limiting
//
// The important thing about this block is how little of it there is.
//
// A "learner profile" is NOT modelled. Everything Phase 10 needs to know — the
// chosen career, completed topics, problems solved, projects built, Git and AI
// progress — is already recorded by Phases 3 to 9, and duplicating it into a
// summary table would create a second source of truth that silently drifts.
// LearnerState is therefore *derived* on read (see lib/personalization/state),
// and recommendations are computed from it rather than stored.
//
// UserActivity is the one genuinely new fact: the existing tables record that
// something IS complete, not WHEN each thing happened in sequence. A weekly
// summary and a recent-activity feed need the sequence, and reconstructing it
// from a dozen timestamp columns across six tables would be both slow and
// fragile.
//
// Nothing here stores a recommendation. Recommendations are a pure function of
// state, so caching one would mean deciding when it goes stale — and the whole
// point is that finishing a lesson changes the answer immediately.
// ─────────────────────────────────────────────────────────────────────────────

/// What a learner did. Deliberately a closed set: an open string would become a
/// dumping ground, and every value here has to earn a place in either the
/// weekly summary or the activity feed.
enum ActivityType {
  CAREER_SELECTED
  LESSON_STARTED
  LESSON_COMPLETED
  PROBLEM_ATTEMPTED
  PROBLEM_SOLVED
  PROJECT_STARTED
  PROJECT_MILESTONE_COMPLETED
  PROJECT_COMPLETED
  GIT_EXERCISE_COMPLETED
  AI_TOOL_STARTED
  AI_WORKFLOW_COMPLETED
}

/// One thing a learner did, at a point in time.
///
/// `label` is a display string captured when the event happened — the topic
/// title, the problem name — so the feed renders without joining to six tables
/// and still reads correctly if content is later renamed.
///
/// There is deliberately no free-form `metadata` blob. A JSON column invites
/// storing whatever is to hand, which is how activity logs quietly become the
/// most sensitive table in an application. Everything worth knowing here is the
/// type, the thing, and when.
model UserActivity {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type ActivityType

  /// The topic, problem, project or tool this refers to. Not a foreign key:
  /// activity is a historical record, and it should survive its subject being
  /// removed from the catalog rather than cascade away with it.
  entityId   String?
  /// Slug for linking, where the subject has a page.
  entitySlug String?
  /// Human-readable, captured at the time.
  label      String

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
  @@map("user_activities")
}

/// How much help the mentor gives on a problem the learner is actively solving.
///
/// Configurable because the right answer genuinely differs: somebody working
/// through their first loops is served by a hint, and somebody unblocking a
/// side project at midnight is not. The default is the conservative one.
enum MentorSolutionPolicy {
  /// Concepts, approaches and progressively stronger hints. Never the answer.
  HINTS_ONLY
  /// Full solutions on request, after the learner has attempted the problem.
  ALLOW_SOLUTIONS
}

model MentorConversation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Derived from the first message, for the conversation list.
  title String?

  messages MentorMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@map("mentor_conversations")
}

enum MentorRole {
  USER
  ASSISTANT
}

/// One turn.
///
/// Only the role and the text. No token counts, no model name, no provider
/// metadata and no request ids — those belong to AIUsage, which is queried for
/// rate limiting and never rendered. Keeping them apart means the table that
/// feeds a page holds nothing but the conversation.
model MentorMessage {
  id             String             @id @default(cuid())
  conversationId String
  conversation   MentorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    MentorRole
  content String

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("mentor_messages")
}

enum AIRequestKind {
  MENTOR
  GUIDANCE
  EXPLANATION
  STUDY_PLAN
}

/// One AI call, for rate limiting and cost visibility.
///
/// Counting rows in a time window is the whole rate limiter. That is slower
/// than an in-memory counter and correct across restarts and multiple
/// instances, which for a per-learner limit measured in requests per hour is
/// the right trade.
///
/// Token counts are the provider's own figures where it reports them, and an
/// estimate otherwise — the column name says which. Nothing from the prompt or
/// the response is stored here.
model AIUsage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind     AIRequestKind
  /// Adapter name, e.g. "anthropic" or "mock". Never a key or an endpoint.
  provider String
  model    String

  inputTokens  Int @default(0)
  outputTokens Int @default(0)

  /// False for a refusal, a timeout or a provider error. Failures are recorded
  /// so a broken provider cannot be retried without limit.
  ok Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("ai_usage")
}

// ─────────────────────────────────────────────────────────────────────────────
// Techie Profile & Developer Readiness (Phase 11)
//
//   Capability → CapabilitySource → (Topic | PracticeProblem | Project |
//                                    Git exercise | AI tool | AI workflow)
//
// The question this phase answers is "what can I actually do?", and the answer
// has to be evidence, not a percentage. A capability is therefore a *claim*
// with sources attached, and a learner's level in it is computed by
// intersecting those sources with the progress they have genuinely made.
//
// There is deliberately no CapabilityEvidence table.
//
// Evidence is derived on read, exactly like Phase 10's LearnerState. Storing a
// row per learner per capability per source would mean a write on every lesson,
// problem, project, exercise and workflow — six more places to keep in sync,
// each of which could drift from the truth it is meant to record. Deriving it
// means completing a lesson changes the level on the next read, with nothing to
// invalidate and nothing that can silently disagree with the progress tables.
// The cost is a handful of indexed reads on the profile page, which is the
// right trade for a number that is never wrong.
//
// Public profile settings live on Profile rather than in a table of their own.
// They are six booleans and a username that every profile has, so a 1:1 table
// would be a join with no upside. They default to private: a learner opts in.
// ─────────────────────────────────────────────────────────────────────────────

/// Where a capability sits in the skills view. Which categories are shown, and
/// in what order, depends on the learner's career — an empty category is never
/// rendered.
enum CapabilityCategory {
  PROGRAMMING
  WEB_DEVELOPMENT
  FRAMEWORKS
  DATA
  DEVELOPER_TOOLS
  VERSION_CONTROL
  AI_SKILLS
  PROJECT_DELIVERY
}

/// What kind of thing counts as evidence for a capability.
///
/// PRACTICE_TOPIC points at a Topic and means "the practice problems attached
/// to this topic", rather than naming individual problems — problems are added
/// to topics over time, and a capability should pick those up without being
/// re-authored.
enum CapabilitySourceKind {
  TOPIC
  PRACTICE_TOPIC
  PROJECT
  GIT_EXERCISE
  AI_TOOL
  AI_WORKFLOW
}

/// How much of a capability a learner has demonstrated.
///
/// The vocabulary is deliberately modest. There is no "Expert", "Master" or
/// "Professional", and there never will be from evidence collected inside one
/// learning platform: CONFIDENT is the ceiling and it already requires
/// completed topics, solved problems and more than one finished project.
/// Telling a beginner they are an expert is not encouragement, it is setting
/// them up to be embarrassed in a room full of people who are.
enum CapabilityLevel {
  EXPLORING
  LEARNING
  PRACTICING
  APPLYING
  CONFIDENT
}

/// A thing a learner can claim to be able to do.
///
/// Authored content, identical for everyone, seeded and never written by the
/// application. It carries no user data at all — the per-learner part is
/// computed from its sources.
model Capability {
  id   String @id @default(cuid())
  slug String @unique
  name String

  /// One line for the card.
  description     String
  /// What "being able to do this" actually means, for the detail page.
  longDescription String

  category CapabilityCategory
  /// Lucide icon name, resolved through a registry at render time.
  icon     String             @default("Code2")

  sortOrder Int @default(0)

  sources CapabilitySource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("capabilities")
}

/// One thing that counts as evidence for a capability.
///
/// `ref` is a content slug rather than a foreign key, and that is deliberate:
/// the six source kinds live in five different tables, and a polymorphic
/// pointer keeps this one small table instead of five join tables that would
/// all need the same treatment. The seed validator resolves every ref and
/// fails loudly on a typo, which is the guarantee a foreign key would have
/// given — enforced at authoring time rather than at write time, because
/// nothing at runtime writes these rows.
model CapabilitySource {
  id           String     @id @default(cuid())
  capabilityId String
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  kind CapabilitySourceKind
  /// Topic slug, project slug, exercise slug, tool slug or workflow slug.
  ref  String

  order Int @default(0)

  @@unique([capabilityId, kind, ref])
  @@index([kind, ref])
  @@map("capability_sources")
}
